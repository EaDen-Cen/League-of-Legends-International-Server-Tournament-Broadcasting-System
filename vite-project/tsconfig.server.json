{
  "compilerOptions": {
    "target": "ES2023",
    "lib": [
      "ES2023"
    ],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "jsx": "react-jsx",
    "types": [
      "node"
    ]
  },
  "include": [
    "server/**/*.ts",
    "src/shared/types.ts",
    "src/components/HeroList.tsx",
    "src/data/**/*.ts"
  ]
}
