# Development defaults bind to loopback only. Production requires three distinct secret tokens.
NODE_ENV=development
HOST=127.0.0.1
PORT=3001
CONTROL_TOKEN=local-control
CASTER_TOKEN=local-caster
OVERLAY_TOKEN=local-overlay
# Opt-in Windows host capture; only authenticated loopback Control can request a frame.
LOL_CAPTURE_ENABLED=0
# For production: NODE_ENV=production, HOST=0.0.0.0, strong tokens (24+ characters).
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3001,http://127.0.0.1:3001
# DATA_FILE=/persistent/path/lol/match.json
# Prefer same-origin HTTPS. Set these only for separate frontend/backend hosting.
# VITE_API_URL=https://broadcast.example.com
# VITE_WS_URL=wss://broadcast.example.com/ws
